{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wink-discography",
  "compatibility_date": "2026-10-18",
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application" },
  "workers_dev": false,
